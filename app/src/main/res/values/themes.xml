<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DigitalWallet" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/wallet_primary</item>
        <item name="colorPrimaryDark">@color/wallet_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/wallet_accent</item>
        <item name="colorSecondary">@color/wallet_accent</item>
        <item name="colorOnSecondary">@color/wallet_text_dark</item>
        <item name="colorSurface">@color/wallet_surface_muted</item>
        <item name="colorOnSurface">@color/wallet_text_light</item>
        <item name="android:colorBackground">@color/wallet_background_light</item>
        <item name="colorOnBackground">@color/wallet_text_light</item>
        <item name="materialCardViewStyle">@style/Widget.DigitalWallet.GlassCard</item>
        <item name="android:statusBarColor">@color/wallet_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.DigitalWallet.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wallet_primary</item>
        <item name="colorPrimaryDark">@color/wallet_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/wallet_accent</item>
        <item name="colorSecondary">@color/wallet_accent</item>
        <item name="colorOnSecondary">@color/wallet_text_dark</item>
        <item name="colorSurface">@color/wallet_surface_muted</item>
        <item name="colorOnSurface">@color/wallet_text_light</item>
        <item name="android:colorBackground">@color/wallet_background_light</item>
        <item name="colorOnBackground">@color/wallet_text_light</item>
        <item name="materialCardViewStyle">@style/Widget.DigitalWallet.GlassCard</item>
        <item name="android:statusBarColor">@color/wallet_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
