<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wallet_background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_finance_details" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_type_income"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_income" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_type_expense"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_expense" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/WalletInputLayout"
                app:helperTextEnabled="true"
                app:helperText="@string/type_label_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_type_label" style="@style/WalletInputEdit"
                    android:hint="@string/field_type_label" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/WalletInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_amount" style="@style/WalletInputEdit"
                    android:hint="@string/field_amount"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/WalletInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_date" style="@style/WalletInputEdit"
                    android:hint="@string/field_date" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/WalletInputLayout"
                app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/edit_category" style="@style/WalletInputEdit"
                    android:hint="@string/field_category_editable"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/WalletInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_source" style="@style/WalletInputEdit"
                    android:hint="@string/field_source" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/WalletInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_notes" style="@style/WalletInputEdit"
                    android:hint="@string/field_notes"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/wallet_accent"
                android:textColor="@color/wallet_text_dark"
                android:text="@string/button_save" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
