<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Faint brand watermark behind the list - not meant to be looked at directly, just a
         premium touch peeking through the gaps between cards and behind the empty state. -->
    <ImageView
        android:layout_width="280dp"
        android:layout_height="239dp"
        android:layout_gravity="center"
        android:alpha="0.06"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_orionmd"
        android:importantForAccessibility="no" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:paddingTop="56dp" />

    <LinearLayout
        android:id="@+id/toolbar_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_toolbar_actions"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_sort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_sort"
            android:src="@drawable/ic_sort"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/button_view_mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_view_mode"
            android:src="@drawable/ic_view_mode"
            app:tint="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_state_default"
        android:textColor="@color/wallet_divider"
        android:textSize="16sp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/add_entry"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorAccent"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
