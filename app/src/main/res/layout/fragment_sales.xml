<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Faint brand watermark, same treatment as the Cards/IDs/Passwords/Contacts lists. -->
    <ImageView
        android:layout_width="280dp"
        android:layout_height="239dp"
        android:layout_gravity="center"
        android:alpha="0.06"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_orionmd"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/wallet_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sales_summary_gross"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/text_total_gross"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sales_summary_net"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/text_total_net"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/wallet_accent"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sales_summary_unpaid"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/text_total_unpaid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/wallet_expense"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolbar_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_toolbar_actions"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_view_mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_view_mode"
            android:src="@drawable/ic_view_mode"
            app:tint="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_state_default"
        android:textColor="@color/wallet_divider"
        android:textSize="16sp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/add_entry"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorAccent"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
